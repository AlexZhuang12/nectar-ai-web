# Supabase — URL must be project origin only (no /rest/v1 suffix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Site URL for Supabase email confirmation (production)
NEXT_PUBLIC_SITE_URL=https://nectar-ai-web.vercel.app

# Optional: used as HTTP-Referer header for OpenRouter
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_VARIANT_ID=your_variant_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# Supabase service role (server-only, for payment webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
